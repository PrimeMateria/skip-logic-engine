#!/usr/bin/env bash
# Pre-commit hook for Skip-Logic Subsystem (ADR-0028)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

echo "======================================================================"
echo " [PRE-COMMIT] Skip-Logic Formal Verification & Scaling Gate (ADR-0028)"
echo "======================================================================"

# Execute full 9-suite verification runner
python3 run_tests.py

# Auto-stage newly generated reports into the commit
if [ -f "reports/TEST_REPORT_LATEST.md" ]; then
    git add reports/TEST_REPORT_LATEST.md reports/test_report_latest.json reports/test_report_latest.md
    echo " [PRE-COMMIT] Auto-staged updated test reports into commit."
fi
if [ -f "reports/STRESS_BENCHMARK_LATEST.md" ]; then
    git add reports/STRESS_BENCHMARK_LATEST.md reports/stress_benchmark_latest.json
    echo " [PRE-COMMIT] Auto-staged updated stress benchmark reports into commit."
fi

echo "======================================================================"
echo " [PRE-COMMIT] All formal gates passed. Commit proceeding."
echo "======================================================================"
exit 0
